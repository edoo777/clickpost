# Copiez ce fichier vers .env.local (jamais commité — voir .gitignore) et renseignez vos
# propres valeurs depuis Project Settings → API sur https://supabase.com/dashboard.
#
# NE JAMAIS utiliser ou exposer la clé "service_role" ici ni ailleurs côté client.

# URL du projet Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon"/"publishable" (Project Settings → API → Project API keys)
# — jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Intégration Anthropic (F2.1) — génération de contenu réelle dans l'Atelier.
# Clé et modèle lus UNIQUEMENT côté serveur (routes Next.js sous src/app/api/ia/),
# jamais dans un composant "use client". Sans ces deux valeurs, ClickPost continue de
# fonctionner avec le générateur simulé (aucun changement de comportement, aucun appel réseau).
#
# NE JAMAIS préfixer ces variables par NEXT_PUBLIC_ — cela les exposerait au navigateur.

# Clé API Anthropic (https://console.anthropic.com/settings/keys) — jamais côté client.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour la génération — jamais codé en dur dans le code.
ANTHROPIC_MODEL=claude-sonnet-5

# Intégration YouTube Data API v3 (Tendances — MVP) — vidéos populaires officielles uniquement.
# Clé lue UNIQUEMENT côté serveur (src/lib/trends/youtube-provider.ts), jamais dans un composant
# "use client". Sans cette valeur, la page /tendances reste fonctionnelle : elle affiche un état
# de configuration manquante pour cette source, sans jamais de fausses données.
#
# NE JAMAIS préfixer par NEXT_PUBLIC_ — cela exposerait la clé au navigateur.
#
# Créer la clé : https://console.cloud.google.com/apis/credentials (activer "YouTube Data API v3"
# sur le projet, puis créer une clé API). Restriction recommandée : "API restrictions" → limiter
# la clé à "YouTube Data API v3" uniquement ; pas de restriction IP possible pour un serveur
# Next.js à IP variable, donc s'appuyer sur la restriction par API et sur le quota gratuit
# (10 000 unités/jour ; chaque appel videos.list coûte 1 unité).
YOUTUBE_API_KEY=

# Intégration LinkedIn réelle (plateforme pilote — voir docs/linkedin-test-integration.md).
# Toutes ces variables restent strictement côté serveur : NE JAMAIS les préfixer par
# NEXT_PUBLIC_. Sans elles, l'intégration LinkedIn reste désactivée et ClickPost continue de
# fonctionner exactement comme avant (mode manuel uniquement pour cette plateforme).
#
# NE JAMAIS commiter de valeur réelle ici ni dans .env.local (déjà exclu de Git) — collez vos
# propres valeurs directement dans .env.local, jamais dans le chat ni dans un fichier suivi.

# Identifiant et secret de l'application LinkedIn (LinkedIn Developer Portal → votre app →
# Auth). Le secret ne doit jamais quitter le serveur (jamais journalisé, jamais renvoyé au
# navigateur).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# URL de redirection OAuth exacte, telle qu'ajoutée dans "Authorized redirect URLs" côté
# LinkedIn — doit correspondre caractère pour caractère (voir docs/linkedin-test-integration.md).
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/social/linkedin/callback

# Version d'API LinkedIn (en-tête "LinkedIn-Version", format AAAAMM) — à vérifier sur
# https://learn.microsoft.com/en-us/linkedin/marketing/versioning avant de la fixer.
LINKEDIN_API_VERSION=

# Clé de chiffrement des jetons OAuth stockés (AES-256-GCM, 32 octets encodés en base64) —
# distincte des identifiants LinkedIn eux-mêmes. Générer une valeur aléatoire propre à chaque
# environnement, par exemple : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Ne jamais réutiliser la même clé entre environnements ni la faire tourner sans plan de
# migration (les jetons déjà chiffrés avec l'ancienne clé deviendraient illisibles).
TOKEN_ENCRYPTION_KEY=

# Clé "service_role" Supabase (Project Settings → API → Project API keys) — contourne la RLS
# par conception. Utilisée UNIQUEMENT par les routes serveur LinkedIn (src/app/api/social/**)
# pour lire/écrire la table social_connections (jetons chiffrés, RLS sans aucune politique
# client). NE JAMAIS exposer cette clé au navigateur, ni l'utiliser pour une autre table.
SUPABASE_SERVICE_ROLE_KEY=

# Secret du planificateur LinkedIn réel (voir vercel.json et
# src/app/api/cron/linkedin-publish/route.ts) — Vercel Cron envoie automatiquement
# "Authorization: Bearer <CRON_SECRET>" à chaque exécution planifiée dès que cette variable est
# définie côté projet Vercel (convention officielle Vercel, aucune configuration supplémentaire
# requise). Générer une valeur aléatoire, par exemple :
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Sans cette variable, la route refuse systématiquement toute exécution (401) — jamais un
# déclenchement de secours sans authentification.
CRON_SECRET=

# Active la publication sur les Pages LinkedIn administrées (Phase 4). NE JAMAIS mettre à "true"
# tant que LinkedIn n'a pas réellement approuvé l'accès organisation pour cette application
# (produit "Community Management API" ou équivalent, portées r_organization_admin +
# w_organization_social) — voir docs/linkedin-production-readiness.md. Tant que ce n'est pas
# "true", aucune UI ni route de connexion de page n'est proposée, quel que soit le contenu des
# autres variables ci-dessus.
LINKEDIN_ORGANIZATION_ACCESS_ENABLED=false

# Intégration Gamma (module Rapports) — génération du document/export PDF d'un rapport. Gamma ne
# détermine jamais les KPI ni l'analyse : ClickPost calcule les données réelles et l'analyse
# Claude, Gamma se charge uniquement de la mise en page/design et de l'export. Clé lue
# UNIQUEMENT côté serveur (src/lib/gamma/client.ts, routes sous src/app/api/gamma/), jamais dans
# un composant "use client". Sans GAMMA_API_KEY, le module Rapports reste entièrement
# fonctionnel : le bouton d'export PDF affiche clairement "Export PDF Gamma non configuré",
# aucune fausse donnée ni faux succès n'est jamais affiché.
#
# NE JAMAIS préfixer ces variables par NEXT_PUBLIC_ — cela les exposerait au navigateur.

# Clé API Gamma (console Gamma → paramètres API) — jamais côté client.
GAMMA_API_KEY=

# Identifiant de modèle/thème Gamma optionnel, pour conserver logo/typographie/identité visuelle
# cohérents entre tous les rapports générés — laisser vide pour utiliser le thème par défaut.
GAMMA_TEMPLATE_ID=

# Espace Admin ClickPost (/admin) — liste d'e-mails autorisés, séparés par des virgules. Jamais un
# rôle stocké en base ni une politique RLS : une simple liste lue côté serveur uniquement (voir
# src/lib/admin/is-platform-admin.ts). Sans cette variable, /admin reste inaccessible à tout le
# monde — jamais un accès ouvert par défaut. Concept entièrement distinct du rôle "admin" d'un
# workspace (qui reste géré normalement dans workspace_members).
#
# NE JAMAIS préfixer par NEXT_PUBLIC_ — cela exposerait la liste au navigateur.
ADMIN_EMAILS=

# URL publique du site (site public marketing — robots.txt, sitemap.xml). Sans cette valeur,
# l'URL de déploiement Vercel est utilisée automatiquement (VERCEL_URL), puis localhost:3000 en
# développement — jamais un domaine de production deviné. À renseigner une fois le domaine réel
# choisi (ex. https://clickpost.app).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------------------
# Intégrations sociales réelles — Instagram, Facebook, TikTok, X, YouTube (voir
# docs/social-platform-setup.md pour la procédure complète, plateforme par plateforme, et
# exactement ce qu'il vous reste à créer/fournir). Toutes ces variables restent strictement
# côté serveur : NE JAMAIS les préfixer par NEXT_PUBLIC_. Sans elles, chaque intégration reste
# désactivée et ClickPost continue de fonctionner exactement comme avant (mode manuel uniquement
# pour la plateforme concernée) — ne bloque jamais le reste de l'application.
# ---------------------------------------------------------------------------------------

# Instagram et Facebook partagent une seule et même application Meta (voir
# src/lib/meta/config.ts) — un seul client_id/client_secret pour les deux, créés sur
# developers.facebook.com. Seule l'URL de redirection diffère entre les deux produits.
META_CLIENT_ID=
META_CLIENT_SECRET=
# Version d'API Graph (format vXX.X, ex. v21.0) — à vérifier sur
# https://developers.facebook.com/docs/graph-api/changelog avant de la fixer.
META_API_VERSION=
META_INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/social/instagram/callback
META_FACEBOOK_REDIRECT_URI=http://localhost:3000/api/social/facebook/callback

# TikTok — application créée sur developers.tiktok.com ("Login Kit" + "Content Posting API").
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/social/tiktok/callback

# X — application créée sur developer.x.com, avec un niveau d'accès permettant la publication
# programmatique (voir docs/social-platform-setup.md).
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/social/x/callback

# YouTube — identifiants OAuth2 "Web application" créés sur console.cloud.google.com (distincts
# de YOUTUBE_API_KEY ci-dessus, qui reste une clé API en lecture seule sans OAuth, utilisée par
# /tendances uniquement). Nécessite un écran de consentement OAuth configuré sur le même projet.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:3000/api/social/youtube/callback
# Visibilité par défaut des vidéos téléversées automatiquement — "private" par défaut (jamais
# "public" sans un choix explicite), voir src/lib/youtube/provider.ts. Valeurs acceptées :
# private, unlisted, public.
YOUTUBE_DEFAULT_PRIVACY_STATUS=private

# Ces cinq intégrations réutilisent TOKEN_ENCRYPTION_KEY et SUPABASE_SERVICE_ROLE_KEY déjà
# définies plus haut pour LinkedIn (même mécanisme de chiffrement et de stockage des jetons,
# table social_connections déjà générique par plateforme) — aucune nouvelle variable de
# chiffrement à créer.
