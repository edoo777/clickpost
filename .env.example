# Copiez ce fichier vers .env.local (jamais commité — voir .gitignore) et renseignez vos
# propres valeurs depuis Project Settings → API sur https://supabase.com/dashboard.
#
# NE JAMAIS utiliser ou exposer la clé "service_role" ici ni ailleurs côté client.

# URL du projet Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon"/"publishable" (Project Settings → API → Project API keys)
# — jamais la clé service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Intégration Anthropic (F2.1) — génération de contenu réelle dans l'Atelier.
# Clé et modèle lus UNIQUEMENT côté serveur (routes Next.js sous src/app/api/ia/),
# jamais dans un composant "use client". Sans ces deux valeurs, ClickPost continue de
# fonctionner avec le générateur simulé (aucun changement de comportement, aucun appel réseau).
#
# NE JAMAIS préfixer ces variables par NEXT_PUBLIC_ — cela les exposerait au navigateur.

# Clé API Anthropic (https://console.anthropic.com/settings/keys) — jamais côté client.
ANTHROPIC_API_KEY=

# Modèle Claude utilisé pour la génération — jamais codé en dur dans le code.
ANTHROPIC_MODEL=claude-sonnet-5

# Intégration YouTube Data API v3 (Tendances — MVP) — vidéos populaires officielles uniquement.
# Clé lue UNIQUEMENT côté serveur (src/lib/trends/youtube-provider.ts), jamais dans un composant
# "use client". Sans cette valeur, la page /tendances reste fonctionnelle : elle affiche un état
# de configuration manquante pour cette source, sans jamais de fausses données.
#
# NE JAMAIS préfixer par NEXT_PUBLIC_ — cela exposerait la clé au navigateur.
#
# Créer la clé : https://console.cloud.google.com/apis/credentials (activer "YouTube Data API v3"
# sur le projet, puis créer une clé API). Restriction recommandée : "API restrictions" → limiter
# la clé à "YouTube Data API v3" uniquement ; pas de restriction IP possible pour un serveur
# Next.js à IP variable, donc s'appuyer sur la restriction par API et sur le quota gratuit
# (10 000 unités/jour ; chaque appel videos.list coûte 1 unité).
YOUTUBE_API_KEY=
